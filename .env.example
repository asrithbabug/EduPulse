# Copy this to .env and fill in your values
# NEVER commit .env to GitHub

# Server
PORT=3001
NODE_ENV=production

# Database (RDS PostgreSQL)
DB_HOST=your-rds-endpoint.rds.amazonaws.com
DB_PORT=5432
DB_NAME=edupulse
DB_USER=edupulse_admin
DB_PASSWORD=your_db_password

# JWT
JWT_SECRET=your_super_secret_jwt_key_min_32_chars
JWT_EXPIRES_IN=7d

# AWS
AWS_REGION=ap-south-1
AWS_ACCESS_KEY_ID=your_access_key
AWS_SECRET_ACCESS_KEY=your_secret_key

# Email (SES)
SES_FROM_EMAIL=noreply@edupulse.in

# App URL (for password setup links in emails)
APP_URL=http://13.126.4.16

# SMS (SNS)
SNS_ENABLED=true

# Firebase Cloud Messaging (Push Notifications — FREE)
# Generate from Firebase Console > Project Settings > Service Accounts > Generate New Private Key
# Paste the entire JSON content as a single line here
FIREBASE_SERVICE_ACCOUNT={"type":"service_account","project_id":"your-project","private_key_id":"...","private_key":"...","client_email":"...","client_id":"...","auth_uri":"...","token_uri":"...","auth_provider_x509_cert_url":"...","client_x509_cert_url":"..."}
